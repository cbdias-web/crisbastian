{
  "name": "Jarvis \u2014 Auto-resolu\u00e7\u00e3o de Chamados",
  "description": "Quando um novo chamado de suporte \u00e9 criado, o Jarvis analisa automaticamente e posta uma resposta (podendo executar a\u00e7\u00f5es como criar contrato/venda) sem interven\u00e7\u00e3o humana.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ChamadoSuporte"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "jarvis_auto_resolu_o_de_chamados",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "resolverChamadoAutomatico",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "resolverChamadoAutomatico"
  }
}