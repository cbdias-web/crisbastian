{
  "name": "Venda",
  "properties": {
    "assessor_comercial": {
      "description": "Nome do assessor/vendedor",
      "type": "string"
    },
    "autorizacao_status": {
      "description": "Autoriza\u00e7\u00e3o da ger\u00eancia: pendente at\u00e9 a libera\u00e7\u00e3o. Vendas n\u00e3o autorizadas n\u00e3o contam na produ\u00e7\u00e3o",
      "enum": [
        "nao_requer",
        "pendente",
        "autorizada",
        "rejeitada"
      ],
      "type": "string"
    },
    "autorizada_em": {
      "description": "Data/hora da autoriza\u00e7\u00e3o",
      "format": "date-time",
      "type": "string"
    },
    "autorizada_por": {
      "description": "E-mail do gestor que autorizou o lan\u00e7amento manual",
      "type": "string"
    },
    "bitrix": {
      "description": "Link do Bitrix",
      "type": "string"
    },
    "boleto_nome": {
      "description": "Nome do arquivo do boleto",
      "type": "string"
    },
    "boleto_url": {
      "description": "URL do boleto de cobran\u00e7a, sincronizado do contrato vinculado",
      "type": "string"
    },
    "cliente": {
      "description": "Nome do cliente",
      "type": "string"
    },
    "codigo_liberacao": {
      "description": "C\u00f3digo de libera\u00e7\u00e3o da ger\u00eancia (uso \u00fanico) consumido por este lan\u00e7amento manual",
      "type": "string"
    },
    "comprovantes": {
      "default": [],
      "description": "Comprovantes de pagamento anexados",
      "items": {
        "properties": {
          "nome": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "considerar_acumulado": {
      "default": true,
      "description": "Se true, a venda \u00e9 considerada no acumulado de vendas do Dashboard e relat\u00f3rios (ainda sujeita a autoriza\u00e7\u00e3o e documentos completos)",
      "type": "boolean"
    },
    "contrato_assinado_nome": {
      "description": "Nome do arquivo do contrato assinado",
      "type": "string"
    },
    "contrato_assinado_url": {
      "description": "URL do contrato assinado, sincronizada do contrato vinculado",
      "type": "string"
    },
    "contrato_id": {
      "description": "ID do contrato vinculado a esta venda (toda nova venda precisa de contrato gerado)",
      "type": "string"
    },
    "cpf_cnpj": {
      "description": "CPF ou CNPJ do cliente",
      "type": "string"
    },
    "data": {
      "description": "Data da venda",
      "format": "date",
      "type": "string"
    },
    "espelhamento": {
      "description": "Nome do primeiro indicador (backward compat)",
      "type": "string"
    },
    "espelhamento_id": {
      "description": "ID do primeiro indicador (backward compat)",
      "type": "string"
    },
    "estrutura_pagamento": {
      "description": "Como o pagamento foi estruturado: a_vista, entrada_parcelas, somente_parcelas (nenhum valor recebido na contrata\u00e7\u00e3o) ou parcela (recorr\u00eancia)",
      "enum": [
        "a_vista",
        "entrada_parcelas",
        "somente_parcelas",
        "parcela"
      ],
      "type": "string"
    },
    "exige_documentos": {
      "default": false,
      "description": "Quando true, a venda s\u00f3 conta na produ\u00e7\u00e3o com contrato assinado e comprovante de pagamento anexados (padr\u00e3o para novos registros)",
      "type": "boolean"
    },
    "forma_pagamento": {
      "description": "Forma de pagamento utilizada",
      "enum": [
        "D\u00c9BITO EM CONTA",
        "CART\u00c3O DE CR\u00c9DITO",
        "BOLETO",
        "PIX",
        "TRANSFER\u00caNCIA",
        "DINHEIRO"
      ],
      "type": "string"
    },
    "indicadores": {
      "description": "Lista de indicadores/espelhamentos da venda (preservada do contrato/indica\u00e7\u00e3o de origem)",
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "percentual": {
            "type": "number"
          },
          "tipo": {
            "description": "Origem do cadastro do indicador: 'indicador' (Espelhamento/Parceiro) ou 'vendedor' (Vendedor usado como espelhamento)",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "num_parcelas": {
      "description": "N\u00famero de parcelas do saldo restante",
      "type": "number"
    },
    "numero_parcela": {
      "description": "Recorr\u00eancia: n\u00famero da parcela recebida",
      "type": "number"
    },
    "observacao": {
      "description": "Observa\u00e7\u00f5es sobre a venda",
      "type": "string"
    },
    "origem_registro": {
      "description": "Origem do registro: 'manual' (lan\u00e7ada na tela de Vendas \u2014 exige c\u00f3digo de libera\u00e7\u00e3o da ger\u00eancia) ou 'contrato' (enviada de um contrato conclu\u00eddo)",
      "enum": [
        "manual",
        "contrato"
      ],
      "type": "string"
    },
    "parcela_id": {
      "description": "Recorr\u00eancia: ID da ParcelaVenda recebida que gerou esta venda (v\u00ednculo 1:1, evita duplicidade)",
      "type": "string"
    },
    "parcelamento": {
      "description": "Data de parcelamento",
      "format": "date",
      "type": "string"
    },
    "percentual_comissao": {
      "description": "Percentual de comiss\u00e3o do vendedor",
      "type": "number"
    },
    "percentual_comissao_espelhamento": {
      "description": "Percentual do primeiro indicador (backward compat)",
      "type": "number"
    },
    "produto": {
      "description": "Nome do produto vendido",
      "type": "string"
    },
    "selecionada_relatorio": {
      "default": false,
      "description": "Flag de sele\u00e7\u00e3o manual: quando true, a venda comp\u00f5e a base do relat\u00f3rio PDF personalizado (gerado a partir das vendas selecionadas)",
      "type": "boolean"
    },
    "time": {
      "description": "Time do vendedor",
      "type": "string"
    },
    "tipo_venda": {
      "description": "Tipo da venda: 'nova' (venda nova \u2014 direcionada para implanta\u00e7\u00e3o) ou 'recorrencia' (pagamento de parcela \u2014 n\u00e3o gera implanta\u00e7\u00e3o)",
      "enum": [
        "nova",
        "recorrencia"
      ],
      "type": "string"
    },
    "total_parcelas": {
      "description": "Recorr\u00eancia: total de parcelas da venda original",
      "type": "number"
    },
    "valor": {
      "description": "Valor recebido na contrata\u00e7\u00e3o (entrada/ades\u00e3o ou \u00e0 vista). Em recorr\u00eancia: valor da parcela recebida",
      "type": "number"
    },
    "valor_total_contrato": {
      "description": "Valor total do contrato (entrada + parcelas)",
      "type": "number"
    },
    "venda_origem_id": {
      "description": "Recorr\u00eancia: ID da venda original (nova) da qual esta parcela faz parte",
      "type": "string"
    },
    "vendedor_id": {
      "description": "ID do vendedor respons\u00e1vel (obrigat\u00f3rio para novas vendas)",
      "type": "string"
    },
    "vendedores_ids": {
      "description": "Lista de vendedores da venda",
      "items": {
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "produto",
    "assessor_comercial",
    "valor",
    "data",
    "tipo_venda"
  ],
  "type": "object"
}