{
  "name": "Venda",
  "type": "object",
  "properties": {
    "produto": {
      "type": "string",
      "description": "Nome do produto vendido"
    },
    "assessor_comercial": {
      "type": "string",
      "description": "Nome do assessor/vendedor"
    },
    "vendedor_id": {
      "type": "string",
      "description": "ID do vendedor responsável (obrigatório para novas vendas)"
    },
    "time": {
      "type": "string",
      "description": "Time do vendedor"
    },
    "contrato_id": {
      "type": "string",
      "description": "ID do contrato vinculado a esta venda (toda nova venda precisa de contrato gerado)"
    },
    "origem_registro": {
      "type": "string",
      "enum": [
        "manual",
        "contrato"
      ],
      "description": "Origem do registro: 'manual' (lançada na tela de Vendas — exige código de liberação da gerência) ou 'contrato' (enviada de um contrato concluído)"
    },
    "codigo_liberacao": {
      "type": "string",
      "description": "Código de liberação da gerência (uso único) consumido por este lançamento manual"
    },
    "autorizacao_status": {
      "type": "string",
      "enum": [
        "nao_requer",
        "pendente",
        "autorizada",
        "rejeitada"
      ],
      "description": "Autorização da gerência: pendente até a liberação. Vendas não autorizadas não contam na produção"
    },
    "autorizada_por": {
      "type": "string",
      "description": "E-mail do gestor que autorizou o lançamento manual"
    },
    "autorizada_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da autorização"
    },
    "exige_documentos": {
      "type": "boolean",
      "default": false,
      "description": "Quando true, a venda só conta na produção com contrato assinado e comprovante de pagamento anexados (padrão para novos registros)"
    },
    "contrato_assinado_url": {
      "type": "string",
      "description": "URL do contrato assinado, sincronizada do contrato vinculado"
    },
    "contrato_assinado_nome": {
      "type": "string",
      "description": "Nome do arquivo do contrato assinado"
    },
    "boleto_url": {
      "type": "string",
      "description": "URL do boleto de cobrança, sincronizado do contrato vinculado"
    },
    "boleto_nome": {
      "type": "string",
      "description": "Nome do arquivo do boleto"
    },
    "tipo_venda": {
      "type": "string",
      "enum": [
        "nova",
        "recorrencia"
      ],
      "description": "Tipo da venda: 'nova' (venda nova — direcionada para implantação) ou 'recorrencia' (pagamento de parcela — não gera implantação)"
    },
    "espelhamento": {
      "type": "string",
      "description": "Nome do primeiro indicador (backward compat)"
    },
    "espelhamento_id": {
      "type": "string",
      "description": "ID do primeiro indicador (backward compat)"
    },
    "percentual_comissao_espelhamento": {
      "type": "number",
      "description": "Percentual do primeiro indicador (backward compat)"
    },
    "indicadores": {
      "type": "array",
      "description": "Lista de indicadores/espelhamentos da venda",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "percentual": {
            "type": "number"
          }
        }
      }
    },
    "valor": {
      "type": "number",
      "description": "Valor da entrada/adesão"
    },
    "valor_total_contrato": {
      "type": "number",
      "description": "Valor total do contrato (entrada + parcelas)"
    },
    "num_parcelas": {
      "type": "number",
      "description": "Número de parcelas do saldo restante"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da venda"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "DÉBITO EM CONTA",
        "CARTÃO DE CRÉDITO",
        "BOLETO",
        "PIX",
        "TRANSFERÊNCIA",
        "DINHEIRO"
      ],
      "description": "Forma de pagamento utilizada"
    },
    "parcelamento": {
      "type": "string",
      "format": "date",
      "description": "Data de parcelamento"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ do cliente"
    },
    "cliente": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "bitrix": {
      "type": "string",
      "description": "Link do Bitrix"
    },
    "comprovantes": {
      "type": "array",
      "description": "Comprovantes de pagamento anexados",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "observacao": {
      "type": "string",
      "description": "Observações sobre a venda"
    },
    "percentual_comissao": {
      "type": "number",
      "description": "Percentual de comissão do vendedor"
    },
    "vendedores_ids": {
      "type": "array",
      "description": "Lista de vendedores da venda",
      "items": {
        "type": "object"
      }
    },
    "considerar_acumulado": {
      "type": "boolean",
      "default": true,
      "description": "Se true, a venda é considerada no acumulado de vendas do Dashboard e relatórios (ainda sujeita a autorização e documentos completos)"
    },
    "selecionada_relatorio": {
      "type": "boolean",
      "default": false,
      "description": "Flag de seleção manual: quando true, a venda compõe a base do relatório PDF personalizado (gerado a partir das vendas selecionadas)"
    },
    "venda_origem_id": {
      "type": "string",
      "description": "Recorrência: ID da venda original (nova) da qual esta parcela faz parte"
    },
    "parcela_id": {
      "type": "string",
      "description": "Recorrência: ID da ParcelaVenda recebida que gerou esta venda (vínculo 1:1, evita duplicidade)"
    },
    "numero_parcela": {
      "type": "number",
      "description": "Recorrência: número da parcela recebida"
    },
    "total_parcelas": {
      "type": "number",
      "description": "Recorrência: total de parcelas da venda original"
    },
    "estrutura_pagamento": {
      "type": "string",
      "enum": [
        "a_vista",
        "entrada_parcelas",
        "somente_parcelas",
        "parcela"
      ],
      "description": "Como o pagamento foi estruturado: a_vista, entrada_parcelas, somente_parcelas (nenhum valor na contratação) ou parcela (recorrência)"
    }
  },
  "required": [
    "produto",
    "assessor_comercial",
    "valor",
    "data",
    "tipo_venda"
  ]
}