{
  "name": "Venda",
  "type": "object",
  "properties": {
    "produto": {
      "type": "string",
      "description": "Nome do produto vendido"
    },
    "assessor_comercial": {
      "type": "string",
      "description": "Nome do assessor/vendedor"
    },
    "vendedor_id": {
      "type": "string",
      "description": "ID do vendedor respons\u00e1vel (obrigat\u00f3rio para novas vendas)"
    },
    "time": {
      "type": "string",
      "description": "Time do vendedor"
    },
    "contrato_id": {
      "type": "string",
      "description": "ID do contrato vinculado a esta venda (toda nova venda precisa de contrato gerado)"
    },
    "origem_registro": {
      "type": "string",
      "enum": [
        "manual",
        "contrato"
      ],
      "description": "Origem do registro: 'manual' (lan\u00e7ada na tela de Vendas \u2014 exige autoriza\u00e7\u00e3o da ger\u00eancia) ou 'contrato' (enviada de um contrato conclu\u00eddo)"
    },
    "autorizacao_status": {
      "type": "string",
      "enum": [
        "nao_requer",
        "pendente",
        "autorizada",
        "rejeitada"
      ],
      "description": "Autoriza\u00e7\u00e3o da ger\u00eancia para vendas lan\u00e7adas manualmente: pendente at\u00e9 um administrador autorizar. Vendas n\u00e3o autorizadas n\u00e3o contam na produ\u00e7\u00e3o"
    },
    "autorizada_por": {
      "type": "string",
      "description": "E-mail do gestor que autorizou o lan\u00e7amento manual"
    },
    "autorizada_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da autoriza\u00e7\u00e3o"
    },
    "exige_documentos": {
      "type": "boolean",
      "default": false,
      "description": "Quando true, a venda s\u00f3 conta na produ\u00e7\u00e3o com contrato assinado e comprovante de pagamento anexados (padr\u00e3o para novos registros)"
    },
    "contrato_assinado_url": {
      "type": "string",
      "description": "URL do contrato assinado, sincronizada do contrato vinculado"
    },
    "contrato_assinado_nome": {
      "type": "string",
      "description": "Nome do arquivo do contrato assinado"
    },
    "boleto_url": {
      "type": "string",
      "description": "URL do boleto de cobran\u00e7a, sincronizado do contrato vinculado"
    },
    "boleto_nome": {
      "type": "string",
      "description": "Nome do arquivo do boleto"
    },
    "tipo_venda": {
      "type": "string",
      "enum": [
        "nova",
        "recorrencia"
      ],
      "description": "Tipo da venda: 'nova' (venda nova \u2014 direcionada para implanta\u00e7\u00e3o) ou 'recorrencia' (pagamento de parcela \u2014 n\u00e3o gera implanta\u00e7\u00e3o)"
    },
    "espelhamento": {
      "type": "string",
      "description": "Nome do primeiro indicador (backward compat)"
    },
    "espelhamento_id": {
      "type": "string",
      "description": "ID do primeiro indicador (backward compat)"
    },
    "percentual_comissao_espelhamento": {
      "type": "number",
      "description": "Percentual do primeiro indicador (backward compat)"
    },
    "indicadores": {
      "type": "array",
      "description": "Lista de indicadores/espelhamentos da venda",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "percentual": {
            "type": "number"
          }
        }
      }
    },
    "valor": {
      "type": "number",
      "description": "Valor da entrada/ades\u00e3o"
    },
    "valor_total_contrato": {
      "type": "number",
      "description": "Valor total do contrato (entrada + parcelas)"
    },
    "num_parcelas": {
      "type": "number",
      "description": "N\u00famero de parcelas do saldo restante"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da venda"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "D\u00c9BITO EM CONTA",
        "CART\u00c3O DE CR\u00c9DITO",
        "BOLETO",
        "PIX",
        "TRANSFER\u00caNCIA",
        "DINHEIRO"
      ],
      "description": "Forma de pagamento utilizada"
    },
    "parcelamento": {
      "type": "string",
      "format": "date",
      "description": "Data de parcelamento"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ do cliente"
    },
    "cliente": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "bitrix": {
      "type": "string",
      "description": "Link do Bitrix"
    },
    "comprovantes": {
      "type": "array",
      "description": "Comprovantes de pagamento anexados",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre a venda"
    },
    "percentual_comissao": {
      "type": "number",
      "description": "Percentual de comiss\u00e3o do vendedor"
    },
    "vendedores_ids": {
      "type": "array",
      "description": "Lista de vendedores da venda",
      "items": {
        "type": "object"
      }
    },
    "considerar_acumulado": {
      "type": "boolean",
      "default": true,
      "description": "Se true, a venda \u00e9 considerada no acumulado de vendas do Dashboard e relat\u00f3rios (ainda sujeita a autoriza\u00e7\u00e3o e documentos completos)"
    },
    "selecionada_relatorio": {
      "type": "boolean",
      "default": false,
      "description": "Flag de sele\u00e7\u00e3o manual: quando true, a venda comp\u00f5e a base do relat\u00f3rio PDF personalizado (gerado a partir das vendas selecionadas)"
    }
  },
  "required": [
    "produto",
    "assessor_comercial",
    "valor",
    "data",
    "tipo_venda"
  ]
}