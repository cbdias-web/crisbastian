{
  "name": "CelulaComentario",
  "properties": {
    "autor_email": {
      "type": "string"
    },
    "autor_nome": {
      "type": "string"
    },
    "celula": {
      "description": "Célula do portal (estruturados, internacional, cross) ou 'geral' para o mural da capa",
      "type": "string"
    },
    "estudo_id": {
      "description": "Operação baseada em EstudoViabilidade (Produtos estruturados)",
      "type": "string"
    },
    "operacao_id": {
      "description": "Operação baseada em Contrato (id do contrato) ou em Pipeline (p_<id>)",
      "type": "string"
    },
    "origem": {
      "default": "usuario",
      "enum": [
        "usuario",
        "ia"
      ],
      "type": "string"
    },
    "pai_id": {
      "description": "Dúvida ou post respondido (para tipo resposta)",
      "type": "string"
    },
    "produto": {
      "description": "Produto da célula (ex.: offshore, conta_internacional, holding, rof, canal_bancario, conta_global, dolarize, cambio, score, rating, diagnostico, monitore)",
      "type": "string"
    },
    "resolvida": {
      "default": false,
      "type": "boolean"
    },
    "texto": {
      "type": "string"
    },
    "tipo": {
      "default": "comentario",
      "description": "comentario = linha do tempo de uma operação; duvida = pergunta da célula; resposta = resposta a uma dúvida ou post; post = publicação no mural da capa; abordagem = contato registrado na negociação (ligação, WhatsApp, reunião, e-mail)",
      "enum": [
        "comentario",
        "duvida",
        "resposta",
        "post",
        "abordagem"
      ],
      "type": "string"
    },
    "canal": {
      "type": "string",
      "description": "Canal da abordagem: ligacao, whatsapp, reuniao, email, outro"
    }
  },
  "required": [
    "celula",
    "texto"
  ],
  "type": "object",
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}