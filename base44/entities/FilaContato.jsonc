{
  "name": "FilaContato",
  "properties": {
    "alerta_stale": {
      "default": false,
      "description": "Alerta de inercia ja disparado pelo scheduler (lead >48h em 'Em Contato' sem interacao). Resetado a cada nova interacao/movimentacao.",
      "type": "boolean"
    },
    "cadencia_id": {
      "description": "Cadencia aplicada ao lead",
      "type": "string"
    },
    "cadencia_passo": {
      "default": 0,
      "description": "Indice do proximo passo da cadencia (0 = primeiro)",
      "type": "number"
    },
    "cidade": {
      "type": "string"
    },
    "cliente_id": {
      "description": "ID do Cliente vinculado (carteira ou convertido de indicacao)",
      "type": "string"
    },
    "consentimento_status": {
      "default": "base_cliente",
      "enum": [
        "base_cliente",
        "opt_in",
        "opt_out",
        "nao_perturbe"
      ],
      "type": "string"
    },
    "cpf_cnpj": {
      "description": "CPF/CNPJ (denormalizado)",
      "type": "string"
    },
    "data_fila": {
      "description": "Dia a que pertence este item da fila",
      "format": "date",
      "type": "string"
    },
    "email": {
      "description": "E-mail do contato",
      "type": "string"
    },
    "entrada_inbound_em": {
      "description": "Quando o lead inbound entrou na fila (base do SLA de primeiro toque)",
      "format": "date-time",
      "type": "string"
    },
    "google_event_id": {
      "description": "ID do evento no Google Calendar (vinculado)",
      "type": "string"
    },
    "historico": {
      "default": [],
      "description": "Linha do tempo de tentativas/atualizacoes do item",
      "items": {
        "properties": {
          "data": {
            "format": "date-time",
            "type": "string"
          },
          "observacao": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "id_externo": {
      "description": "ID do negocio na origem (ex: Bitrix) - evita duplicidade em reimportacoes",
      "type": "string"
    },
    "lead_indicacao_id": {
      "description": "ID da LeadIndicacao (quando tipo_origem=indicacao e houver indicacao de origem)",
      "type": "string"
    },
    "lote_id": {
      "description": "Lote de importacao de origem",
      "type": "string"
    },
    "meet_link": {
      "description": "Link da reuniao Google Meet (vinculado)",
      "type": "string"
    },
    "nome": {
      "description": "Nome do contato (denormalizado)",
      "type": "string"
    },
    "origem_label": {
      "description": "Label legivel da origem (ex: 'Indicacao - Nome do Parceiro', 'Carteira')",
      "type": "string"
    },
    "parceiro_email": {
      "description": "E-mail do indicador (denormalizado de Parceiro/LeadIndicacao) para o gerente interagir com o responsavel pela indicacao",
      "type": "string"
    },
    "parceiro_nome": {
      "description": "Nome do parceiro/indicador que indicou o lead (denormalizado de LeadIndicacao)",
      "type": "string"
    },
    "parceiro_percentual": {
      "description": "Percentual de comissionamento do parceiro (denormalizado de LeadIndicacao)",
      "type": "number"
    },
    "parceiro_telefone": {
      "description": "Telefone/WhatsApp do indicador (denormalizado de Parceiro) para o gerente interagir com o responsavel pela indicacao",
      "type": "string"
    },
    "posicao": {
      "default": 1,
      "description": "Ordem dentro do dia/prioridade (1 = primeiro)",
      "type": "number"
    },
    "primeiro_toque_em": {
      "description": "Primeiro toque registrado (speed-to-lead)",
      "format": "date-time",
      "type": "string"
    },
    "prioridade": {
      "default": 1,
      "description": "0=indicacao (topo), 1=carteira",
      "type": "number"
    },
    "produto": {
      "description": "Produto de interesse (denormalizado)",
      "type": "string"
    },
    "produto_contratado": {
      "description": "Produto ja contratado pelo cliente no Grupo Villela (gancho para venda cruzada)",
      "type": "string"
    },
    "proximo_contato": {
      "description": "Data reagendada apos 'nao atendeu' (proximo dia util) ou do retorno obrigatorio agendado ao entrar em 'Em Contato'",
      "format": "date",
      "type": "string"
    },
    "proximo_contato_hora": {
      "description": "Horario (HH:MM) do retorno obrigatorio agendado ao mover o lead para 'Em Contato'",
      "type": "string"
    },
    "proximo_toque_em": {
      "description": "Quando vence o proximo toque da cadencia (UTC)",
      "format": "date-time",
      "type": "string"
    },
    "ref_id": {
      "description": "ID da entidade de origem: Cliente.id (carteira) ou ConversaWhatsapp.id (indicacao)",
      "type": "string"
    },
    "responsavel_origem": {
      "description": "Responsavel pelo contrato na origem (celula/advogado do Grupo)",
      "type": "string"
    },
    "reuniao_em": {
      "description": "Data/hora da reuniao marcada (UTC)",
      "format": "date-time",
      "type": "string"
    },
    "score": {
      "description": "Score 0-100",
      "type": "number"
    },
    "segmento": {
      "description": "Segmento calculado pelo score",
      "enum": [
        "quente",
        "morno",
        "frio"
      ],
      "type": "string"
    },
    "status": {
      "default": "pendente",
      "description": "Status do item na fila (pendente=na fila, atendeu=em contato, reuniao_marcada=reuniao agendada, qualificado, convertido, descartado=desqualificado, nao_atendeu=reagendado, nutricao=desqualificacao temporaria)",
      "enum": [
        "pendente",
        "atendeu",
        "nao_atendeu",
        "reuniao_marcada",
        "qualificado",
        "convertido",
        "descartado",
        "nutricao"
      ],
      "type": "string"
    },
    "status_desde": {
      "description": "Data/hora em que o lead entrou no status atual - base do contador de dias parado e do alerta de inercia (SLA 48h em 'Em Contato')",
      "format": "date-time",
      "type": "string"
    },
    "telefone": {
      "description": "Telefone/WhatsApp do contato (denormalizado)",
      "type": "string"
    },
    "telefone_e164": {
      "description": "Telefone normalizado E.164 (+55...)",
      "type": "string"
    },
    "telefone_valido": {
      "default": true,
      "type": "boolean"
    },
    "tentativas": {
      "default": 0,
      "description": "Numero de 'nao atendeu' no dia",
      "type": "number"
    },
    "tentativas_contato": {
      "default": 0,
      "description": "Tentativas de contato registradas enquanto o lead esta em 'Em Contato' (ex: ligacao/WhatsApp sem retorno). A partir de 4 tentativas o lead e sugerido para Nutricao (ghosting).",
      "type": "number"
    },
    "tipo_origem": {
      "description": "Origem do contato: 'carteira' (Cliente/AgendaContato) ou 'indicacao' (ConversaWhatsapp/LeadIndicacao)",
      "enum": [
        "carteira",
        "indicacao"
      ],
      "type": "string"
    },
    "tipo_pessoa": {
      "enum": [
        "PF",
        "PJ"
      ],
      "type": "string"
    },
    "uf": {
      "type": "string"
    },
    "ultima_tentativa_em": {
      "description": "Data/hora da ultima tentativa de contato",
      "format": "date-time",
      "type": "string"
    },
    "valor_contrato": {
      "description": "Valor do contrato original",
      "type": "number"
    },
    "valor_estimado": {
      "description": "Valor estimado da indicacao (denormalizado de LeadIndicacao)",
      "type": "number"
    },
    "vendedor_email": {
      "description": "E-mail do gerente responsavel (denormalizado; base para regras de acesso por linha)",
      "type": "string"
    },
    "vendedor_id": {
      "description": "ID do gerente responsavel pelo contato",
      "type": "string"
    },
    "vendedor_nome": {
      "description": "Nome do gerente responsavel",
      "type": "string"
    },
    "whatsapp_primeiro_em": {
      "description": "Primeiro WhatsApp enviado ao lead (controle de limite diario)",
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "tipo_origem",
    "ref_id",
    "nome",
    "vendedor_id",
    "data_fila",
    "status"
  ],
  "type": "object"
}