{
  "name": "ConversaWhatsapp",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "ID do lead vinculado"
    },
    "lead_nome": {
      "type": "string",
      "description": "Nome do lead"
    },
    "telefone": {
      "type": "string",
      "description": "N\u00famero WhatsApp do lead (com DDI, ex: 5511999998888)"
    },
    "vendedor_id": {
      "type": "string",
      "description": "ID do gerente respons\u00e1vel"
    },
    "vendedor_nome": {
      "type": "string",
      "description": "Nome do gerente respons\u00e1vel"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "qualificado",
        "encerrada"
      ],
      "default": "ativa",
      "description": "Status da conversa"
    },
    "origem": {
      "type": "string",
      "description": "Origem da campanha (ex: campanha_junho, base_clientes)"
    },
    "mensagens": {
      "type": "array",
      "description": "Hist\u00f3rico de mensagens",
      "items": {
        "type": "object",
        "properties": {
          "de": {
            "type": "string"
          },
          "texto": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "enviada",
              "recebida"
            ]
          }
        }
      },
      "default": []
    },
    "ultima_mensagem": {
      "type": "string",
      "description": "Texto da \u00faltima mensagem para preview"
    },
    "ultima_mensagem_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da \u00faltima mensagem"
    },
    "nao_lidas": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de mensagens n\u00e3o lidas pelo gerente"
    },
    "produto_interesse": {
      "type": "string",
      "description": "Produto de interesse identificado pela IA"
    },
    "observacao_ia": {
      "type": "string",
      "description": "Resumo/contexto gerado pela IA sobre o lead"
    }
  },
  "required": [
    "telefone",
    "lead_nome"
  ]
}