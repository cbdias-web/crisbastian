{
  "name": "MensagemChat",
  "type": "object",
  "properties": {
    "canal": {
      "type": "string",
      "description": "Nome do canal (ex: geral, time-a, diretoria) ou ID de chat direto"
    },
    "tipo_canal": {
      "type": "string",
      "enum": [
        "canal",
        "direto"
      ],
      "default": "canal",
      "description": "Canal p\u00fablico ou conversa direta"
    },
    "remetente_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio remetente"
    },
    "remetente_nome": {
      "type": "string",
      "description": "Nome do remetente"
    },
    "remetente_email": {
      "type": "string",
      "description": "Email do remetente"
    },
    "destinatario_email": {
      "type": "string",
      "description": "Email do destinat\u00e1rio (apenas para chat direto)"
    },
    "texto": {
      "type": "string",
      "description": "Conte\u00fado da mensagem"
    },
    "meet_link": {
      "type": "string",
      "description": "Link de reuni\u00e3o Meet gerado nesta mensagem"
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL do arquivo anexado (imagem, documento, \u00e1udio, v\u00eddeo)"
    },
    "arquivo_nome": {
      "type": "string",
      "description": "Nome original do arquivo anexado"
    },
    "arquivo_tipo": {
      "type": "string",
      "description": "MIME type do arquivo (ex: image/jpeg, application/pdf, audio/mpeg, video/mp4)"
    }
  },
  "required": [
    "canal",
    "remetente_nome"
  ]
}