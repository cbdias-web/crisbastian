{
  "name": "Implantacao",
  "type": "object",
  "properties": {
    "venda_id": {
      "type": "string",
      "description": "ID da venda de origem"
    },
    "contrato_id": {
      "type": "string",
      "description": "ID do contrato vinculado (auto-vinculado ou manual)"
    },
    "contrato_encontrado": {
      "type": "boolean",
      "default": true,
      "description": "Se o contrato foi encontrado automaticamente no sistema"
    },
    "contrato_url_manual": {
      "type": "string",
      "description": "URL do contrato anexado manualmente (quando n\u00e3o encontrado)"
    },
    "contrato_nome_manual": {
      "type": "string",
      "description": "Nome do arquivo do contrato anexado manualmente"
    },
    "condicoes_implantacao": {
      "type": "string",
      "description": "Condi\u00e7\u00f5es especiais de implanta\u00e7\u00e3o especificadas manualmente"
    },
    "requer_abertura_cc": {
      "type": "boolean",
      "description": "Se esta implanta\u00e7\u00e3o exige Rate/Taxa de Cust\u00f3dia e Link de Abertura de Conta Corrente (trava de workflow). Selecionado por lead no popup de implanta\u00e7\u00e3o. Quando ausente, o padr\u00e3o por produto decide (C\u00e2mbio, Hora T\u00e9cnica, Rating etc. dispensam)."
    },
    "rate_custodia": {
      "type": "number",
      "description": "Rate / Taxa de Cust\u00f3dia (%) informada pelo gerente/padrinho. Valor entre 0,01 e 4,00. Obrigat\u00f3rio para habilitar o Link de Abertura CC e mover o lead de status/coluna.",
      "minimum": 0.01,
      "maximum": 4
    },
    "link_abertura_cc": {
      "type": "string",
      "description": "Link externo de Abertura de Conta Corrente que direciona o Padrinho/Gerente para a \u00e1rea externa. S\u00f3 \u00e9 habilitado ap\u00f3s o preenchimento do Rate. Obrigat\u00f3rio para mover o lead de coluna/status."
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do Cliente vinculado (chave de v\u00ednculo do hist\u00f3rico de intera\u00e7\u00f5es)"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ do cliente"
    },
    "produto": {
      "type": "string",
      "description": "Produto/contrato vendido"
    },
    "vendedor_id": {
      "type": "string",
      "description": "ID do vendedor respons\u00e1vel pela venda"
    },
    "vendedor_nome": {
      "type": "string",
      "description": "Nome do vendedor respons\u00e1vel pela venda"
    },
    "padrinho_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio padrinho respons\u00e1vel pela gest\u00e3o da implanta\u00e7\u00e3o do produto"
    },
    "padrinho_nome": {
      "type": "string",
      "description": "Nome do padrinho respons\u00e1vel pelo produto"
    },
    "padrinho_email": {
      "type": "string",
      "description": "E-mail do padrinho (para notifica\u00e7\u00f5es Jarvis e e-mail)"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando_documentacao",
        "em_andamento",
        "aguardando_cliente",
        "rejeitado_compliance",
        "concluido",
        "concluido_feedback",
        "cancelado"
      ],
      "default": "aguardando_documentacao",
      "description": "Status da implanta\u00e7\u00e3o"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media",
      "description": "Prioridade da implanta\u00e7\u00e3o"
    },
    "responsavel_implantacao": {
      "type": "string",
      "description": "Nome do respons\u00e1vel por conduzir a implanta\u00e7\u00e3o"
    },
    "data_entrada": {
      "type": "string",
      "format": "date",
      "description": "Data de entrada do processo de implanta\u00e7\u00e3o"
    },
    "data_prevista_conclusao": {
      "type": "string",
      "format": "date",
      "description": "Data prevista para conclus\u00e3o"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date",
      "description": "Data de conclus\u00e3o efetiva"
    },
    "etapas": {
      "type": "array",
      "description": "Checklist de etapas da implanta\u00e7\u00e3o organizadas por fase",
      "items": {
        "type": "object",
        "properties": {
          "fase": {
            "type": "string",
            "description": "Nome da fase (ex: Contratos & Compliance, Documenta\u00e7\u00e3o, Onboarding)"
          },
          "descricao": {
            "type": "string"
          },
          "concluida": {
            "type": "boolean"
          },
          "concluida_em": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "historico": {
      "type": "array",
      "description": "Timeline de atualiza\u00e7\u00f5es de status e observa\u00e7\u00f5es",
      "items": {
        "type": "object",
        "properties": {
          "status_anterior": {
            "type": "string"
          },
          "status_novo": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          },
          "atualizado_por": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais sobre a implanta\u00e7\u00e3o"
    },
    "valor_contrato": {
      "type": "number",
      "description": "Valor do contrato/produto vendido"
    }
  },
  "required": [
    "cliente_nome",
    "produto"
  ]
}