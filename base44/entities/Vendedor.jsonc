{
  "name": "Vendedor",
  "properties": {
    "alertas_silenciados": {
      "default": false,
      "description": "Silencia alertas nao criticos",
      "type": "boolean"
    },
    "ativo": {
      "default": true,
      "description": "Vendedor ativo",
      "type": "boolean"
    },
    "ativo_central_leads": {
      "default": true,
      "description": "Participa da esteira de distribuicao de leads na Central de Leads (webhook/campanhas externas)",
      "type": "boolean"
    },
    "avatar_url": {
      "description": "URL da foto/avatar do colaborador",
      "type": "string"
    },
    "canal_alerta": {
      "default": "ambos",
      "description": "Como o gerente quer receber alertas",
      "enum": [
        "push",
        "email",
        "ambos"
      ],
      "type": "string"
    },
    "celular_operadora": {
      "description": "Celular do gerente (E.164, ex: +5551999998888) usado para ligar/WhatsApp pelo proprio chip",
      "type": "string"
    },
    "celular_validado_em": {
      "description": "Quando o gerente confirmou o teste do celular",
      "format": "date-time",
      "type": "string"
    },
    "email": {
      "description": "Email do vendedor",
      "type": "string"
    },
    "emails_alternativos": {
      "default": [],
      "description": "Outros e-mails/logins do mesmo gerente (ex.: conta pessoal). Usados para vincular o usuario logado ao vendedor correto",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "em_ferias": {
      "default": false,
      "description": "Gerente em ferias: fica fora da roleta de distribuicao de leads enquanto o periodo estiver ativo",
      "type": "boolean"
    },
    "ferias_inicio": {
      "description": "Primeiro dia de ausencia (ferias)",
      "format": "date",
      "type": "string"
    },
    "ferias_fim": {
      "description": "Ultimo dia de ausencia (ferias)",
      "format": "date",
      "type": "string"
    },
    "ferias_observacao": {
      "description": "Observacao sobre as ferias (motivo, substituto combinado etc.)",
      "type": "string"
    },
    "janela_fim": {
      "description": "Fim da janela de contato (HH:MM) - sobrescreve ConfigFila",
      "type": "string"
    },
    "janela_inicio": {
      "description": "Inicio da janela de contato (HH:MM) - sobrescreve ConfigFila",
      "type": "string"
    },
    "meta_diaria_toques": {
      "description": "Meta diaria de toques - sobrescreve ConfigFila",
      "type": "number"
    },
    "nome": {
      "description": "Nome do vendedor",
      "type": "string"
    },
    "operadora": {
      "description": "Operadora do celular",
      "enum": [
        "Vivo",
        "Claro",
        "TIM",
        "Oi",
        "Outra"
      ],
      "type": "string"
    },
    "percentual_comissao": {
      "default": 10,
      "description": "Percentual de comissao padrao (%)",
      "type": "number"
    },
    "recebe_leads_indicacao": {
      "default": true,
      "description": "Recebe leads originados do Portal do Indicador na roleta de distribuicao",
      "type": "boolean"
    },
    "time": {
      "description": "Time do vendedor",
      "type": "string"
    },
    "ultimo_lead_distribuido_em": {
      "description": "Data/hora do ultimo lead distribuido a este gerente (controle da roleta justa)",
      "format": "date-time",
      "type": "string"
    },
    "whatsapp_no_mesmo_numero": {
      "default": true,
      "description": "O WhatsApp do gerente usa o mesmo numero",
      "type": "boolean"
    }
  },
  "required": [
    "nome"
  ],
  "type": "object"
}