{
  "name": "Vendedor",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "email": {
      "type": "string",
      "description": "Email do vendedor"
    },
    "time": {
      "type": "string",
      "description": "Time do vendedor"
    },
    "percentual_comissao": {
      "type": "number",
      "description": "Percentual de comiss\u00e3o padr\u00e3o (%)",
      "default": 10
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Vendedor ativo"
    },
    "ativo_central_leads": {
      "type": "boolean",
      "default": true,
      "description": "Participa da esteira de distribui\u00e7\u00e3o de leads na Central de Leads (webhook/campanhas externas)"
    },
    "recebe_leads_indicacao": {
      "type": "boolean",
      "default": true,
      "description": "Recebe leads originados do Portal do Indicador na roleta de distribui\u00e7\u00e3o"
    },
    "ultimo_lead_distribuido_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do \u00faltimo lead distribu\u00eddo a este gerente (controle da roleta justa)"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL da foto/avatar do colaborador"
    }
  },
  "required": [
    "nome"
  ]
}