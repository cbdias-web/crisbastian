{
  "name": "RncCanalBancario",
  "type": "object",
  "properties": {
    "contrato_id": {
      "type": "string",
      "description": "ID do contrato Canal Bancario vinculado"
    },
    "tipo_canal": {
      "type": "string",
      "enum": [
        "PF",
        "PJ"
      ],
      "description": "Tipo de canal: Pessoa Fisica (PF) ou Pessoa Juridica (PJ)"
    },
    "operar_acima_270k": {
      "type": "boolean",
      "default": false,
      "description": "Operar valores superiores a R$ 270.000,00 no periodo de 12 meses"
    },
    "nome": {
      "type": "string",
      "description": "Nome completo (PF) ou Razao Social (PJ)"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF (PF) ou CNPJ (PJ)"
    },
    "rg_ie": {
      "type": "string",
      "description": "RG (PF) ou Inscricao Estadual (PJ)"
    },
    "nascimento_fundacao": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento (PF) ou fundacao (PJ)"
    },
    "nacionalidade": {
      "type": "string",
      "description": "Nacionalidade (PF) ou nacionalidade da empresa (PJ)"
    },
    "profissao_natureza": {
      "type": "string",
      "description": "Profissao (PF) ou natureza juridica (PJ)"
    },
    "estado_civil": {
      "type": "string",
      "description": "Estado civil (PF)"
    },
    "dupla_nacionalidade": {
      "type": "string",
      "enum": [
        "sim",
        "nao"
      ],
      "description": "Possui dupla nacionalidade? (PF)"
    },
    "media_salarial": {
      "type": "number",
      "description": "Media salarial em R$ (PF)"
    },
    "quantidade_funcionarios": {
      "type": "number",
      "description": "Quantidade de funcionarios (PJ)"
    },
    "email": {
      "type": "string",
      "description": "E-mail de contato"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone / WhatsApp"
    },
    "cep": {
      "type": "string",
      "description": "CEP do endereco"
    },
    "endereco": {
      "type": "string",
      "description": "Logradouro (rua, numero, complemento)"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "documentos": {
      "type": "array",
      "description": "Checklist de documentos necessarios para abertura do canal bancario",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "description": "Chave do tipo de documento (identificacao, comprovante_endereco, contrato_social, etc.)"
          },
          "descricao": {
            "type": "string",
            "description": "Descricao legivel do documento"
          },
          "obrigatorio": {
            "type": "boolean"
          },
          "recebido": {
            "type": "boolean",
            "default": false
          },
          "url": {
            "type": "string",
            "description": "URL do arquivo enviado"
          },
          "nome_arquivo": {
            "type": "string",
            "description": "Nome do arquivo enviado"
          }
        }
      },
      "default": []
    },
    "socios": {
      "type": "array",
      "description": "Socios e administradores (apenas PJ) com seus documentos",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "cpf": {
            "type": "string"
          },
          "documento_url": {
            "type": "string",
            "description": "URL do documento de identificacao com foto"
          },
          "documento_nome": {
            "type": "string"
          },
          "comprovante_url": {
            "type": "string",
            "description": "URL do comprovante de endereco"
          },
          "comprovante_nome": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "pdf_url": {
      "type": "string",
      "description": "URL do PDF gerado com todos os dados da RNC"
    },
    "pdf_nome": {
      "type": "string",
      "description": "Nome do arquivo PDF gerado"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "concluido",
        "enviado"
      ],
      "default": "rascunho",
      "description": "Status da RNC"
    },
    "preenchido_por": {
      "type": "string",
      "description": "Nome do usuario que preencheu a RNC"
    },
    "data_preenchimento": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do preenchimento"
    },
    "observacoes": {
      "type": "string",
      "description": "Observacoes adicionais"
    },
    "link_token": {
      "type": "string",
      "description": "Token unico do link publico de preenchimento pelo cliente"
    },
    "link_gerado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o link foi gerado"
    },
    "link_origem_admin": {
      "type": "string",
      "description": "E-mail do admin que gerou o link"
    },
    "link_preenchido_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da ultima submissao do cliente via link"
    }
  },
  "required": [
    "tipo_canal",
    "nome"
  ]
}