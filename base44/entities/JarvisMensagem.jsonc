{
  "name": "JarvisMensagem",
  "type": "object",
  "properties": {
    "destinatario_email": {
      "type": "string",
      "description": "E-mail do destinat\u00e1rio"
    },
    "remetente_nome": {
      "type": "string",
      "description": "Nome do remetente"
    },
    "remetente_email": {
      "type": "string",
      "description": "E-mail do remetente (para confirma\u00e7\u00e3o de leitura)"
    },
    "mensagem": {
      "type": "string",
      "description": "Conte\u00fado da mensagem"
    },
    "lida": {
      "type": "boolean",
      "default": false,
      "description": "Mensagem j\u00e1 foi exibida"
    },
    "lida_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que a mensagem foi lida"
    }
  },
  "required": [
    "destinatario_email",
    "mensagem"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.destinatario_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.destinatario_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}