{
  "name": "AlertaGerente",
  "properties": {
    "chave": {
      "description": "Chave de deduplicacao (tipo+fila+janela)",
      "type": "string"
    },
    "criado_em": {
      "format": "date-time",
      "type": "string"
    },
    "expira_em": {
      "format": "date-time",
      "type": "string"
    },
    "fila_id": {
      "type": "string"
    },
    "lido": {
      "default": false,
      "type": "boolean"
    },
    "prioridade": {
      "default": "media",
      "enum": [
        "baixa",
        "media",
        "alta"
      ],
      "type": "string"
    },
    "texto": {
      "type": "string"
    },
    "tipo": {
      "enum": [
        "inbound_novo",
        "retorno_agora",
        "retorno_atrasado",
        "reuniao_15min",
        "sla_inbound",
        "lead_respondeu",
        "cadencia_vencida",
        "meta_diaria",
        "no_show",
        "escalonado",
        "outro"
      ],
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "vendedor_id": {
      "type": "string"
    }
  },
  "required": [
    "vendedor_id",
    "tipo",
    "titulo"
  ],
  "type": "object"
}