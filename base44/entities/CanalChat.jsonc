{
  "name": "CanalChat",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do canal"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do canal"
    },
    "icone": {
      "type": "string",
      "description": "Emoji ou \u00edcone do canal",
      "default": "\ud83d\udcac"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "membros": {
      "type": "array",
      "description": "Lista de emails dos membros do canal",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "criador_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que criou o canal"
    }
  },
  "required": [
    "nome"
  ]
}