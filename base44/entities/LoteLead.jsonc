{
  "name": "LoteLead",
  "properties": {
    "distribuido_em": {
      "description": "Data/hora da distribuicao",
      "format": "date-time",
      "type": "string"
    },
    "distribuido_por": {
      "description": "Email do admin que distribuiu",
      "type": "string"
    },
    "liberacao": {
      "default": "manual",
      "description": "automatica = libera diariamente por cota e capacidade dos gerentes",
      "enum": [
        "manual",
        "automatica"
      ],
      "type": "string"
    },
    "liberados": {
      "default": 0,
      "description": "Leads ja liberados aos gerentes (liberacao automatica)",
      "type": "number"
    },
    "nome": {
      "description": "Nome identificador do lote",
      "type": "string"
    },
    "pausado": {
      "default": false,
      "description": "Pausa a liberacao automatica deste lote",
      "type": "boolean"
    },
    "status": {
      "default": "pendente",
      "description": "pendente=aguardando distribuicao manual; em_liberacao=liberacao automatica em curso; distribuido=todos liberados",
      "enum": [
        "pendente",
        "distribuido",
        "em_liberacao"
      ],
      "type": "string"
    },
    "total": {
      "description": "Total de leads no lote",
      "type": "number"
    },
    "ultima_liberacao_em": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "nome",
    "total"
  ],
  "type": "object"
}