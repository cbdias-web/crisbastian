{
  "name": "Lead",
  "properties": {
    "base_legal": {
      "description": "Base legal LGPD definida pelo juridico",
      "type": "string"
    },
    "cadencia_id": {
      "description": "Cadencia a aplicar quando o lead for liberado",
      "type": "string"
    },
    "cep": {
      "type": "string"
    },
    "cidade": {
      "type": "string"
    },
    "cliente_id": {
      "description": "ID do cliente gerado apos conversao",
      "type": "string"
    },
    "consentimento_status": {
      "default": "base_cliente",
      "enum": [
        "base_cliente",
        "opt_in",
        "opt_out",
        "nao_perturbe"
      ],
      "type": "string"
    },
    "convertido": {
      "default": false,
      "description": "Lead foi convertido em cliente cativo",
      "type": "boolean"
    },
    "convertido_em": {
      "description": "Data/hora da conversao",
      "format": "date-time",
      "type": "string"
    },
    "cpf_cnpj": {
      "description": "CPF ou CNPJ",
      "type": "string"
    },
    "email": {
      "description": "Email do lead",
      "type": "string"
    },
    "endereco": {
      "type": "string"
    },
    "id_externo": {
      "description": "ID do negocio na origem (ex: Bitrix); evita duplicidade em reimportacoes",
      "type": "string"
    },
    "liberar_em": {
      "description": "Data de liberacao (onda) para a fila do gerente",
      "format": "date",
      "type": "string"
    },
    "lote_id": {
      "description": "ID do lote de importacao",
      "type": "string"
    },
    "lote_nome": {
      "description": "Nome do lote de importacao",
      "type": "string"
    },
    "nome": {
      "description": "Nome do lead",
      "type": "string"
    },
    "observacao": {
      "description": "Observacoes / resumo da IA",
      "type": "string"
    },
    "onda": {
      "description": "Numero da onda de liberacao",
      "type": "number"
    },
    "opt_out_em": {
      "format": "date-time",
      "type": "string"
    },
    "origem": {
      "description": "Origem do lead (campanha_externa, base_clientes, etc)",
      "type": "string"
    },
    "produto_contratado": {
      "description": "Produto ja contratado no Grupo Villela",
      "type": "string"
    },
    "produto_interesse": {
      "description": "Produto de interesse",
      "type": "string"
    },
    "responsavel_origem": {
      "description": "Responsavel na origem (celula/advogado)",
      "type": "string"
    },
    "score": {
      "description": "Score 0-100",
      "type": "number"
    },
    "segmento": {
      "enum": [
        "quente",
        "morno",
        "frio"
      ],
      "type": "string"
    },
    "status": {
      "default": "pendente",
      "description": "Status do lead",
      "enum": [
        "pendente",
        "distribuido",
        "novo"
      ],
      "type": "string"
    },
    "telefone": {
      "description": "Telefone de contato",
      "type": "string"
    },
    "telefone_e164": {
      "description": "Telefone normalizado +55...",
      "type": "string"
    },
    "telefone_valido": {
      "default": true,
      "type": "boolean"
    },
    "tipo_pessoa": {
      "enum": [
        "PF",
        "PJ"
      ],
      "type": "string"
    },
    "uf": {
      "type": "string"
    },
    "valor_contrato": {
      "description": "Valor do contrato original",
      "type": "number"
    },
    "vendedor_id": {
      "description": "ID do vendedor ao qual foi distribuido",
      "type": "string"
    },
    "vendedor_nome": {
      "description": "Nome do vendedor ao qual foi distribuido",
      "type": "string"
    }
  },
  "required": [
    "nome"
  ],
  "type": "object"
}