{
  "name": "Lead",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do lead"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "email": {
      "type": "string",
      "description": "Email do lead"
    },
    "lote_id": {
      "type": "string",
      "description": "ID do lote de importa\u00e7\u00e3o"
    },
    "lote_nome": {
      "type": "string",
      "description": "Nome do lote de importa\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "distribuido",
        "novo"
      ],
      "default": "pendente",
      "description": "Status do lead"
    },
    "origem": {
      "type": "string",
      "description": "Origem do lead (campanha_externa, base_clientes, etc)"
    },
    "produto_interesse": {
      "type": "string",
      "description": "Produto de interesse"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es / resumo da IA"
    },
    "vendedor_id": {
      "type": "string",
      "description": "ID do vendedor ao qual foi distribu\u00eddo"
    },
    "vendedor_nome": {
      "type": "string",
      "description": "Nome do vendedor ao qual foi distribu\u00eddo"
    },
    "convertido": {
      "type": "boolean",
      "default": false,
      "description": "Lead foi convertido em cliente cativo"
    },
    "convertido_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da convers\u00e3o"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente gerado ap\u00f3s convers\u00e3o"
    }
  },
  "required": [
    "nome"
  ]
}