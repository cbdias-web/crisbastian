{
  "name": "TreinamentoModulo",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do m\u00f3dulo"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do m\u00f3dulo"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o",
      "default": 0
    },
    "capa_url": {
      "type": "string",
      "description": "URL da imagem de capa"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "M\u00f3dulo vis\u00edvel para usu\u00e1rios"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria / tag do m\u00f3dulo"
    }
  },
  "required": [
    "titulo"
  ]
}