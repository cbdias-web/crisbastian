{
  "name": "InteracaoCliente",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "vendedor_id": {
      "type": "string",
      "description": "ID do vendedor"
    },
    "vendedor_nome": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Liga\u00e7\u00e3o",
        "WhatsApp",
        "E-mail",
        "Reuni\u00e3o",
        "Visita",
        "Outro"
      ],
      "description": "Tipo de intera\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da intera\u00e7\u00e3o"
    },
    "data_interacao": {
      "type": "string",
      "format": "date",
      "description": "Data da intera\u00e7\u00e3o"
    },
    "proximo_contato": {
      "type": "string",
      "format": "date",
      "description": "Data do pr\u00f3ximo contato"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "Positivo",
        "Neutro",
        "Negativo",
        "Sem resposta"
      ],
      "description": "Resultado da intera\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "realizada",
        "agendada"
      ],
      "default": "realizada",
      "description": "Status: 'realizada' (conclu\u00edda) ou 'agendada' (pr\u00f3ximo contato pendente de preenchimento)"
    }
  },
  "required": [
    "cliente_id",
    "cliente_nome",
    "vendedor_id",
    "tipo",
    "descricao",
    "data_interacao"
  ]
}