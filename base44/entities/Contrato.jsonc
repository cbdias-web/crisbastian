{
  "name": "Contrato",
  "properties": {
    "administracao_debitos": {
      "default": [],
      "description": "Tipos de débitos administrados (específico para GARANTIAS)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "agencia": {
      "description": "Agência bancária",
      "type": "string"
    },
    "bairro": {
      "description": "Bairro",
      "type": "string"
    },
    "banco": {
      "description": "Banco para débito (se aplicável)",
      "type": "string"
    },
    "boleto_nome": {
      "description": "Nome do arquivo do boleto",
      "type": "string"
    },
    "boleto_url": {
      "description": "URL do boleto de pagamento (anexado pelo administrador)",
      "type": "string"
    },
    "boletos_parcelas": {
      "default": [],
      "description": "Boletos das parcelas vincendas anexados pelo gerente/admin para cobrança do cliente",
      "items": {
        "properties": {
          "descricao": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "vencimento": {
            "format": "date",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "cep": {
      "description": "CEP",
      "type": "string"
    },
    "cidade": {
      "description": "Cidade",
      "type": "string"
    },
    "cliente_id": {
      "description": "ID do cliente (se vinculado)",
      "type": "string"
    },
    "comprovante_nome": {
      "description": "Nome do arquivo do comprovante principal",
      "type": "string"
    },
    "comprovante_url": {
      "description": "URL do comprovante de pagamento principal (anexado pelo gerente). Mantido em sincronia com o primeiro item de 'comprovantes' (compatibilidade).",
      "type": "string"
    },
    "comprovantes": {
      "default": [],
      "description": "Comprovantes de pagamento anexados pelo gerente/admin (até 3). O primeiro elemento equivale a comprovante_url/comprovante_nome (compatibilidade).",
      "items": {
        "properties": {
          "nome": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "conta": {
      "description": "Conta bancária",
      "type": "string"
    },
    "contrato_assinado_nome": {
      "description": "Nome do arquivo do contrato assinado",
      "type": "string"
    },
    "contrato_assinado_url": {
      "description": "URL do contrato assinado (anexado pelo gerente)",
      "type": "string"
    },
    "cotacao": {
      "description": "Cotação da moeda no momento da contratação",
      "type": "number"
    },
    "cpf_cnpj": {
      "description": "CPF ou CNPJ",
      "type": "string"
    },
    "cpf_responsavel": {
      "description": "CPF do responsável legal",
      "type": "string"
    },
    "data_contrato": {
      "description": "Data do contrato",
      "format": "date",
      "type": "string"
    },
    "data_primeira_parcela": {
      "description": "Data da 1ª parcela (início do parcelamento negociado, pode diferir da data do 1º pagamento/entrada)",
      "format": "date",
      "type": "string"
    },
    "data_primeiro_pagamento": {
      "description": "Data do primeiro pagamento",
      "format": "date",
      "type": "string"
    },
    "dia_vencimento": {
      "description": "Dia do vencimento das parcelas (RATING/SCORE/DIAGNÓSTICO: parcelas de adesão)",
      "type": "number"
    },
    "dia_vencimento_diagnostico": {
      "description": "Dia de vencimento do valor somente diagnóstico — específico para RATING",
      "type": "number"
    },
    "dia_vencimento_mensalidade": {
      "description": "Dia de vencimento da mensalidade — específico para SCORE",
      "type": "number"
    },
    "email": {
      "description": "E-mail",
      "type": "string"
    },
    "endereco": {
      "description": "Endereço completo (Rua, número, complemento)",
      "type": "string"
    },
    "escopo_rating": {
      "description": "Serviço contratado (checkbox do modelo) — específico para RATING",
      "enum": [
        "Organização Financeira",
        "Rating",
        "Rating + Organização Financeira"
      ],
      "type": "string"
    },
    "estado": {
      "description": "Estado (UF)",
      "type": "string"
    },
    "estado_civil": {
      "description": "Estado civil",
      "enum": [
        "Solteiro(a)",
        "Casado(a)",
        "Divorciado(a)",
        "Viúvo(a)",
        "União Estável"
      ],
      "type": "string"
    },
    "estrutura_jurisdicao": {
      "description": "Jurisdição (país/estado) onde a estrutura internacional será constituída — específico para OFFSHORE",
      "type": "string"
    },
    "estrutura_qtd_entidades": {
      "description": "Número de entidades jurídicas na estrutura nacional — específico para OFFSHORE",
      "type": "number"
    },
    "forma_pagamento": {
      "description": "Forma de pagamento",
      "enum": [
        "PIX",
        "TED/DOC",
        "DÉBITO EM CONTA",
        "BOLETO",
        "CARTÃO DE CRÉDITO",
        "Transferência Internacional"
      ],
      "type": "string"
    },
    "incluir_agente_juridico_ia": {
      "default": false,
      "description": "Inclui o módulo AGENTE JURÍDICO.IA nesta contratação — específico para OFFSHORE",
      "type": "boolean"
    },
    "indicadores": {
      "description": "Indicadores/espelhamentos vinculados ao contrato",
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "percentual": {
            "type": "number"
          },
          "tipo": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "link_assinatura": {
      "description": "Link de assinatura online do contrato (gerado automaticamente via ZapSign ou preenchido manualmente)",
      "type": "string"
    },
    "link_assinatura_aditivo": {
      "description": "Link de assinatura online do aditivo de contrato (preenchido pelo administrador)",
      "type": "string"
    },
    "link_pagamento": {
      "description": "Link de pagamento (preenchido pelo administrador)",
      "type": "string"
    },
    "mensalidade": {
      "description": "Mensalidade (específico para GARANTIAS, RATING e SCORE)",
      "type": "number"
    },
    "moeda": {
      "description": "Moeda do contrato (USD, EUR, etc.)",
      "type": "string"
    },
    "nacionalidade": {
      "description": "Nacionalidade",
      "type": "string"
    },
    "nascimento": {
      "description": "Data de nascimento",
      "format": "date",
      "type": "string"
    },
    "nome": {
      "description": "Nome completo / Razão Social",
      "type": "string"
    },
    "num_parcelas": {
      "description": "Número de parcelas",
      "type": "number"
    },
    "numero_contrato": {
      "description": "Número sequencial do contrato exibido no PDF (ex.: 00142/2026) — específico para OFFSHORE",
      "type": "string"
    },
    "observacoes": {
      "description": "Observações adicionais",
      "type": "string"
    },
    "origem_pagamento": {
      "description": "Origem/forma do pagamento realizado",
      "enum": [
        "Boleto",
        "Link de Pagamento",
        "PIX",
        "TED",
        "Outros"
      ],
      "type": "string"
    },
    "pdf_url": {
      "description": "URL do PDF gerado",
      "type": "string"
    },
    "percentual_montante": {
      "description": "Percentual sobre o montante da dívida (específico para GARANTIAS)",
      "type": "number"
    },
    "pipeline_id": {
      "description": "ID do registro no pipeline gerado",
      "type": "string"
    },
    "prazo_implantacao_dias": {
      "default": 90,
      "description": "Prazo de implantação da estrutura, em dias — específico para OFFSHORE",
      "type": "number"
    },
    "prazo_meses": {
      "description": "Prazo total em meses",
      "type": "number"
    },
    "prazo_suspensao_dias": {
      "default": 60,
      "description": "Prazo de suspensão do prazo de implantação em caso de pendência, em dias — específico para OFFSHORE",
      "type": "number"
    },
    "profissao": {
      "description": "Profissão",
      "type": "string"
    },
    "responsavel_legal": {
      "description": "Nome do responsável legal",
      "type": "string"
    },
    "rg": {
      "description": "RG ou documento de identidade (PF) — usado no contrato OFFSHORE",
      "type": "string"
    },
    "status": {
      "default": "rascunho",
      "description": "Status do contrato",
      "enum": [
        "rascunho",
        "gerado",
        "assinado",
        "aguardando_pagamento",
        "pago",
        "no_pipeline",
        "cancelado"
      ],
      "type": "string"
    },
    "telefone": {
      "description": "Telefone / WhatsApp",
      "type": "string"
    },
    "tipo": {
      "description": "Tipo de contrato",
      "enum": [
        "CONTA GLOBAL",
        "CONTA INTERNACIONAL",
        "DOLARIZE",
        "ROF",
        "CANAL BANCÁRIO",
        "OFFSHORE",
        "GARANTIAS",
        "HORA TÉCNICA",
        "RATING",
        "DIAGNÓSTICO",
        "SCORE",
        "MONITORE"
      ],
      "type": "string"
    },
    "valor_adesao": {
      "description": "Valor de adesão / entrada",
      "type": "number"
    },
    "valor_diagnostico": {
      "description": "Valor somente diagnóstico — específico para RATING",
      "type": "number"
    },
    "valor_divida": {
      "description": "Valor da dívida (específico para GARANTIAS)",
      "type": "number"
    },
    "valor_em_moeda": {
      "description": "Valor em moeda estrangeira",
      "type": "number"
    },
    "valor_parcela": {
      "description": "Valor de cada parcela",
      "type": "number"
    },
    "valor_total": {
      "description": "Valor total do contrato (RATING/SCORE: valor da adesão; DIAGNÓSTICO: valor do diagnóstico)",
      "type": "number"
    },
    "vendedor_id": {
      "description": "ID do vendedor responsável",
      "type": "string"
    },
    "vendedor_nome": {
      "description": "Nome do vendedor responsável",
      "type": "string"
    },
    "zapsign_doc_token": {
      "description": "Token do documento de assinatura eletrônica criado na ZapSign (rastreio do envio ao cliente)",
      "type": "string"
    },
    "natureza_pagamento": {
      "type": "string",
      "enum": [
        "nova",
        "recorrencia"
      ],
      "default": "nova",
      "description": "Natureza do envio para Vendas: 'nova' (venda nova) ou 'recorrencia' (pagamento de parcela de contrato/venda existente)"
    },
    "parcela_origem_id": {
      "type": "string",
      "description": "Quando natureza_pagamento = recorrencia: ID da ParcelaVenda que está sendo paga"
    },
    "venda_origem_id": {
      "type": "string",
      "description": "Quando natureza_pagamento = recorrencia: ID da venda original"
    }
  },
  "required": [
    "tipo",
    "nome",
    "cpf_cnpj"
  ],
  "type": "object"
}