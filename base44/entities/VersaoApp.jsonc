{
  "name": "VersaoApp",
  "type": "object",
  "properties": {
    "versao": {
      "type": "string",
      "description": "Identificador da vers\u00e3o publicada (timestamp da publica\u00e7\u00e3o)"
    },
    "publicada_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da publica\u00e7\u00e3o da nova vers\u00e3o"
    },
    "publicada_por": {
      "type": "string",
      "description": "ID do usu\u00e1rio que realizou a publica\u00e7\u00e3o"
    },
    "primeira_publicacao": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 a primeira publica\u00e7\u00e3o do aplicativo"
    },
    "mensagem": {
      "type": "string",
      "description": "Mensagem exibida na barra de atualiza\u00e7\u00e3o para os usu\u00e1rios"
    }
  },
  "required": [
    "publicada_em"
  ]
}