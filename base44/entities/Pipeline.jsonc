{
  "name": "Pipeline",
  "type": "object",
  "properties": {
    "vendedor_id": {
      "type": "string",
      "description": "ID do vendedor/gerente respons\u00e1vel"
    },
    "vendedor_nome": {
      "type": "string",
      "description": "Nome do vendedor/gerente respons\u00e1vel"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente (se j\u00e1 cadastrado)"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente/prospect"
    },
    "cliente_cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ do cliente"
    },
    "cliente_telefone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "produto": {
      "type": "string",
      "description": "Produto em negocia\u00e7\u00e3o"
    },
    "valor_estimado": {
      "type": "number",
      "description": "Valor estimado do neg\u00f3cio"
    },
    "data_prevista": {
      "type": "string",
      "format": "date",
      "description": "Data prevista para fechamento"
    },
    "temperatura": {
      "type": "string",
      "enum": [
        "Frio",
        "Morno",
        "Quente",
        "Fechado",
        "Perdido"
      ],
      "default": "Frio",
      "description": "Temperatura/status da negocia\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da negocia\u00e7\u00e3o e pr\u00f3ximos passos"
    },
    "origem": {
      "type": "string",
      "enum": [
        "Carteira",
        "Lead",
        "Indica\u00e7\u00e3o",
        "Prospec\u00e7\u00e3o Ativa",
        "Outro"
      ],
      "default": "Prospec\u00e7\u00e3o Ativa",
      "description": "Origem do neg\u00f3cio"
    },
    "proximo_contato": {
      "type": "string",
      "format": "date",
      "description": "Data do pr\u00f3ximo contato agendado"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "cliente_nome",
    "produto",
    "temperatura"
  ]
}