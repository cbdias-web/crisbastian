{
  "name": "ComandoDiscagem",
  "properties": {
    "canal": {
      "enum": [
        "ligar",
        "whatsapp"
      ],
      "type": "string"
    },
    "criado_em": {
      "format": "date-time",
      "type": "string"
    },
    "fila_id": {
      "type": "string"
    },
    "mensagem": {
      "description": "Texto pre-preenchido do WhatsApp",
      "type": "string"
    },
    "nome": {
      "type": "string"
    },
    "produto_contratado": {
      "type": "string"
    },
    "status": {
      "default": "enviado",
      "enum": [
        "enviado",
        "aberto",
        "concluido"
      ],
      "type": "string"
    },
    "telefone_e164": {
      "type": "string"
    },
    "vendedor_id": {
      "type": "string"
    }
  },
  "required": [
    "vendedor_id",
    "canal",
    "telefone_e164"
  ],
  "type": "object"
}