{
  "name": "Espelhamento",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do indicador"
    },
    "email": {
      "type": "string",
      "description": "Email do indicador"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone do indicador"
    },
    "percentual_comissao": {
      "type": "number",
      "description": "Percentual de comissao padrao",
      "default": 10
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Indicador ativo"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": "any_user",
    "read": "public",
    "update": "admin_only",
    "delete": "admin_only"
  }
}