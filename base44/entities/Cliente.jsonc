{
  "name": "Cliente",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome completo do cliente"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ"
    },
    "email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "vendedor_id": {
      "type": "string",
      "description": "ID do vendedor respons\u00e1vel (carteira)"
    },
    "vendedor_nome": {
      "type": "string",
      "description": "Nome do vendedor respons\u00e1vel (carteira)"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "origem": {
      "type": "string",
      "enum": [
        "nativo",
        "lead",
        "lead_convertido"
      ],
      "default": "nativo",
      "description": "Origem do cliente"
    },
    "lead_id": {
      "type": "string",
      "description": "ID do lead de origem (quando aplic\u00e1vel)"
    },
    "subcarteira": {
      "type": "string",
      "description": "Nome da subcarteira/pasta para organizar grupos de leads"
    }
  },
  "required": [
    "nome"
  ]
}