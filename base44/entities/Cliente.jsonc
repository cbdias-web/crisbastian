{
  "name": "Cliente",
  "properties": {
    "bairro": {
      "description": "Bairro",
      "type": "string"
    },
    "cadencia_id": {
      "description": "Cadencia aplicada",
      "type": "string"
    },
    "cep": {
      "description": "CEP do endereco",
      "type": "string"
    },
    "cidade": {
      "description": "Cidade",
      "type": "string"
    },
    "consentimento_status": {
      "default": "base_cliente",
      "enum": [
        "base_cliente",
        "opt_in",
        "opt_out",
        "nao_perturbe"
      ],
      "type": "string"
    },
    "cpf_cnpj": {
      "description": "CPF ou CNPJ",
      "type": "string"
    },
    "cpf_responsavel": {
      "description": "CPF do responsavel legal (PJ)",
      "type": "string"
    },
    "email": {
      "description": "Email do cliente",
      "type": "string"
    },
    "endereco": {
      "description": "Logradouro (rua, numero, complemento)",
      "type": "string"
    },
    "estado": {
      "description": "Estado (UF)",
      "type": "string"
    },
    "estado_civil": {
      "description": "Estado civil (PF)",
      "type": "string"
    },
    "id_externo": {
      "description": "ID do negocio na origem",
      "type": "string"
    },
    "lead_id": {
      "description": "ID do lead de origem (quando aplicavel)",
      "type": "string"
    },
    "liberar_em": {
      "description": "Data de liberacao na fila",
      "format": "date",
      "type": "string"
    },
    "nacionalidade": {
      "description": "Nacionalidade (PF)",
      "type": "string"
    },
    "nascimento": {
      "description": "Data de nascimento (PF)",
      "format": "date",
      "type": "string"
    },
    "nome": {
      "description": "Nome completo do cliente",
      "type": "string"
    },
    "observacao": {
      "description": "Observacoes",
      "type": "string"
    },
    "origem": {
      "default": "nativo",
      "description": "Origem do cliente",
      "enum": [
        "nativo",
        "lead",
        "lead_convertido"
      ],
      "type": "string"
    },
    "produto_contratado": {
      "description": "Produto ja contratado no Grupo Villela",
      "type": "string"
    },
    "profissao": {
      "description": "Profissao (PF)",
      "type": "string"
    },
    "responsavel_legal": {
      "description": "Nome do responsavel legal (PJ)",
      "type": "string"
    },
    "responsavel_origem": {
      "description": "Responsavel na origem (celula/advogado)",
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "segmento": {
      "enum": [
        "quente",
        "morno",
        "frio"
      ],
      "type": "string"
    },
    "subcarteira": {
      "description": "Nome da subcarteira/pasta para organizar grupos de leads",
      "type": "string"
    },
    "telefone": {
      "description": "Telefone de contato",
      "type": "string"
    },
    "telefone_e164": {
      "type": "string"
    },
    "telefone_valido": {
      "default": true,
      "type": "boolean"
    },
    "tipo_pessoa": {
      "enum": [
        "PF",
        "PJ"
      ],
      "type": "string"
    },
    "valor_contrato": {
      "type": "number"
    },
    "vendedor_id": {
      "description": "ID do vendedor responsavel (carteira)",
      "type": "string"
    },
    "vendedor_nome": {
      "description": "Nome do vendedor responsavel (carteira)",
      "type": "string"
    }
  },
  "required": [
    "nome"
  ],
  "type": "object"
}