      "type": "string",
      "description": "Nome do vendedor espelhamento"
    },
    "valor_venda": {
      "type": "number",
      "description": "Valor da venda"
    },
    "percentual": {
      "type": "number",
      "description": "Percentual de comiss\u00e3o aplicado"
