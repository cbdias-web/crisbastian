{
  "name": "EstudoViabilidade",
  "type": "object",
  "properties": {
    "produto": {
      "type": "string",
      "enum": [
        "holding",
        "offshore",
        "conta_internacional"
      ],
      "description": "Produto objeto do estudo tecnico"
    },
    "produto_origem": {
      "type": "string",
      "enum": [
        "holding",
        "offshore",
        "conta_internacional"
      ],
      "description": "Produto original do estudo quando o administrador altera a origem (ex.: holding -> offshore). A analise da IA passa a ser construida a partir do novo produto, sem descartar a avaliacao do produto de origem"
    },
    "produto_alterado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da ultima alteracao de origem/produto do estudo"
    },
    "produto_alterado_por": {
      "type": "string",
      "description": "E-mail do administrador que alterou a origem/produto do estudo"
    },
    "analise_base_id": {
      "type": "string",
      "description": "ID da PropostaTecnica usada como referencia de metodo quando a analise e gerada a partir de outra ja existente (outro cliente)"
    },
    "tipo_cliente": {
      "type": "string",
      "enum": [
        "PF",
        "PJ"
      ],
      "description": "Natureza do cliente: Pessoa Fisica ou Pessoa Juridica"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do Cliente vinculado (opcional)"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome / razao social do cliente"
    },
    "cliente_email": {
      "type": "string"
    },
    "cliente_telefone": {
      "type": "string"
    },
    "cliente_documento": {
      "type": "string",
      "description": "CPF ou CNPJ"
    },
    "responsavel_email": {
      "type": "string",
      "description": "E-mail do gerente/consultor responsavel"
    },
    "responsavel_nome": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "enviado_cliente",
        "em_preenchimento",
        "recebido",
        "em_analise_tecnica",
        "concluido",
        "cancelado"
      ],
      "default": "rascunho",
      "description": "Etapa do estudo"
    },
    "respostas": {
      "type": "object",
      "description": "Respostas do formulario (identificacao, proposito, patrimonio e campos especificos do produto)",
      "additionalProperties": true
    },
    "documentos": {
      "type": "array",
      "description": "Documentos anexados pelo cliente",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "nome_arquivo": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "enviado_em": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "nda_url": {
      "type": "string",
      "description": "Arquivo do NDA enviado na abertura do estudo (file_uri privado)"
    },
    "nda_nome": {
      "type": "string",
      "description": "Nome do arquivo do NDA"
    },
    "nda_dados": {
      "type": "object",
      "description": "Dados cadastrais extraidos do NDA, usados como base do cadastro do cliente quando ele nao existe na base",
      "additionalProperties": true
    },
    "aceite_lgpd": {
      "type": "boolean",
      "default": false
    },
    "preenchido_por_nome": {
      "type": "string"
    },
    "observacoes_internas": {
      "type": "string"
    },
    "parecer_tecnico": {
      "type": "string",
      "description": "Reservado para o modulo de Analise Tecnica"
    },
    "score_viabilidade": {
      "type": "number",
      "description": "Score 0-100 da ultima analise"
    },
    "classificacao_viabilidade": {
      "type": "string"
    },
    "proposta_atual_id": {
      "type": "string",
      "description": "ID da versao vigente da PropostaTecnica"
    },
    "proposta_versao": {
      "type": "number"
    },
    "proposta_status": {
      "type": "string"
    },
    "analise_gerada_em": {
      "type": "string",
      "format": "date-time"
    },
    "link_token": {
      "type": "string"
    },
    "link_gerado_em": {
      "type": "string",
      "format": "date-time"
    },
    "link_ultimo_acesso_em": {
      "type": "string",
      "format": "date-time"
    },
    "link_preenchido_em": {
      "type": "string",
      "format": "date-time"
    },
    "data_envio_cliente": {
      "type": "string",
      "format": "date-time"
    },
    "data_recebimento": {
      "type": "string",
      "format": "date-time"
    },
    "data_envio_analise": {
      "type": "string",
      "format": "date-time"
    },
    "enviado_analise_por": {
      "type": "string"
    },
    "ultimo_alerta_cliente_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do ultimo aviso enviado ao consultor/admins sobre o preenchimento ou envio do formulario pelo cliente (controle anti-repeticao)"
    },
    "cliente_devolveu_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o cliente devolveu o formulario com todas as informacoes e documentos obrigatorios (mesmo que falte apenas a declaracao final de envio)"
    },
    "nda_origem": {
      "type": "string",
      "enum": [
        "anexado",
        "gerado"
      ],
      "description": "Como o NDA entrou: anexado (arquivo enviado) ou gerado no portal (modelo Villela Exchange)"
    },
    "nda_gerado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o NDA foi gerado no portal"
    },
    "nda_partes": {
      "type": "array",
      "description": "Partes do CLIENTE usadas na geração do NDA (PF/PJ, qualificação, representante, sigla)",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "nda_config": {
      "type": "object",
      "description": "Parâmetros do NDA gerado (multa, vigência, sigilo, não evasão, foro, local, data)",
      "additionalProperties": true
    },
    "nda_assinado_url": {
      "type": "string",
      "description": "Arquivo do NDA assinado (file_uri privado)"
    },
    "nda_assinado_nome": {
      "type": "string"
    },
    "nda_assinado_em": {
      "type": "string",
      "format": "date-time"
    },
    "origem_operacao": {
      "type": "string",
      "description": "Como a operação nasceu: portal (padrão) ou migracao (migrada de um contrato antigo)"
    }
  },
  "required": [
    "produto",
    "tipo_cliente"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.responsavel_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.responsavel_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}