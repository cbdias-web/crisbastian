    {
      "function_name": "jarvisListarVendas",
      "description": "OBRIGATÓRIO para qualquer consulta de vendas. Nunca use read_Venda. Parâmetros opcionais: mes (ex: '2026-03') e vendedor_nome (parcial).",
      "parameters": {
        "type": "object",
        "properties": {
          "mes": {
            "type": "string",
            "description": "Mês no formato YYYY-MM."
          },
          "vendedor_nome": {
            "type": "string",
            "description": "Nome parcial do vendedor."
          }
        }
      }
    },
    {
      "function_name": "jarvisEnviarMensagemChat",
      "description": "Envia uma mensagem diretamente no chat do Jarvis de um ou mais usuários. Use para comunicados e notificações de suporte.",
      "parameters": {
        "type": "object",
        "properties": {
          "destinatarios_emails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mensagem": {
            "type": "string"
          },
          "remetente_nome": {
            "type": "string"
          }
        },
        "required": [
          "destinatarios_emails",
          "mensagem"
        ]
      }
    },
    {
      "function_name": "jarvisGerarPDF",
