          "titulo": {
            "type": "string",
            "description": "T\u00edtulo principal do relat\u00f3rio"
          },
          "subtitulo": {
            "type": "string",
            "description": "Subt\u00edtulo ou per\u00edodo do relat\u00f3rio (opcional)"
          },
