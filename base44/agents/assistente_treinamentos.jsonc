    {
      "function_name": "jarvisListarVendas",
      "description": "OBRIGAT\u00d3RIO para qualquer consulta de vendas. Nunca use read_Venda. Par\u00e2metros opcionais: mes (ex: '2026-03') e vendedor_nome (parcial).",
      "parameters": {
        "type": "object",
        "properties": {
          "mes": {
            "type": "string",
            "description": "M\u00eas no formato YYYY-MM."
          },
          "vendedor_nome": {
            "type": "string",
            "description": "Nome parcial do vendedor."
          }
        }
      }
    },
    {
      "function_name": "jarvisEnviarMensagemChat",
      "description": "Envia uma mensagem diretamente no chat do Jarvis de um ou mais usu\u00e1rios. Use para comunicados e notifica\u00e7\u00f5es de suporte.",
      "parameters": {
        "type": "object",
        "properties": {
          "destinatarios_emails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mensagem": {
            "type": "string"
          },
          "remetente_nome": {
            "type": "string"
          }
        },
        "required": [
          "destinatarios_emails",
          "mensagem"
        ]
      }
    },
    {
      "function_name": "jarvisGerarPDF",
      "description": "Gera um relat\u00f3rio em PDF e devolve file_url + filename para download. Use APENAS dados reais j\u00e1 buscados. Inclua o link [Baixar PDF](file_url) na resposta.",
      "parameters": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string"
          },
          "subtitulo": {
            "type": "string"
          },
          "secoes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "titulo",
          "secoes"
        ]
      }
    },
    {
      "function_name": "jarvisEnviarEmail",
      "description": "Envia um e-mail. Sempre confirme com o usu\u00e1rio antes de enviar.",
      "parameters": {
        "type": "object",
        "properties": {
          "destinatario_email": {
            "type": "string"
          },
          "destinatario_nome": {
            "type": "string"
          },
          "assunto": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          }
        },
        "required": [
          "destinatario_email",
          "assunto",
          "mensagem"
        ]
      }
    }
  ]
