      "parameters": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string"
          },
          "subtitulo": {
            "type": "string"
          },
          "secoes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "titulo",
          "secoes"
        ]
      }
    },
    {
      "function_name": "jarvisEnviarEmail",
      "description": "Envia um e-mail. Sempre confirme com o usuário antes de enviar.",
      "parameters": {
        "type": "object",
        "properties": {
          "destinatario_email": {
            "type": "string"
          },
          "destinatario_nome": {
            "type": "string"
          },
          "assunto": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          }
        },
        "required": [
          "destinatario_email",
          "assunto",
          "mensagem"
        ]
      }
    },
    {
      "function_name": "extrairDadosContrato",
      "description": "Lê um documento ANEXADO pelo usuário (RG, CNH, contrato social, cartão CNPJ, comprovante, NDA, proposta) e devolve os dados cadastrais e da negociação já no formato do portal (campos de Cliente/Contrato). Use o file_uri informado na mensagem do usuário. Parâmetro tipo = tipo de contrato pretendido (ex.: 'DOLARIZE', 'OFFSHORE'); se não souber, use 'OUTRO'.",
      "parameters": {
        "type": "object",
        "properties": {
          "file_uri": {
            "type": "string",
            "description": "file_uri do anexo, exatamente como veio na mensagem"
          },
          "tipo": {
            "type": "string",
            "description": "Tipo de contrato pretendido"
          }
        },
        "required": [
          "file_uri"
        ]
      }
    },
    {
      "function_name": "jarvisGerarContratoPDF",
      "description": "Gera o PDF oficial de um contrato JÁ CADASTRADO na entidade Contrato (mesmo modelo da tela de Contratos), salva o PDF no contrato e devolve file_url. Chame só depois de criar/atualizar o Contrato e confirmar os dados com o usuário.",
      "parameters": {
        "type": "object",
        "properties": {
          "contrato_id": {
            "type": "string"
          }
        },
        "required": [
          "contrato_id"
        ]
      }
    },
    {
      "entity_name": "EstudoViabilidade",
      "allowed_operations": [
        "create",
        "update",
        "read"
      ]
    }
